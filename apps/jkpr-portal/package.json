{
  "name": "jkpr-portal",
  "productName": "JahKnowsPR Portal",
  "version": "1.0.0",
  "private": true,
  "author": "VaughnX Technology LLC",
  "description": "Desktop shell for the JahKnowsPR / KORA dashboard (macOS, website distribution)",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --mac"
  },
  "build": {
    "electronVersion": "33.2.1",
    "appId": "com.vaughnx.jkprportal",
    "copyright": "Copyright © VaughnX Technology LLC",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "static/**/*"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "^25.1.8"
  }
}
