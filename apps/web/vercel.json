{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/kora",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/kora/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/consultation/kora-platform",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/blog",
      "destination": "/the-brief",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "/the-brief/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), usb=(), interest-cohort=()"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        }
      ]
    }
  ]
}
  