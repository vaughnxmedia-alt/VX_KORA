# Supabase (Project Settings → API). Anon key is safe for the browser; still never commit .env.
# Put this file at apps/web/.env OR at the repo root (KORA/.env) — Vite merges both; apps/web wins on duplicate keys.
# Every variable exposed to the browser MUST start with VITE_. Restart `npm run dev` after editing.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use either the publishable key name or the anon key name (same value from Supabase → API):
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_public_key_here
# VITE_SUPABASE_ANON_KEY=your_anon_public_key_here

# Square Web Payments SDK (public — safe in the browser; never commit real .env to git)
# Application ID and Location ID from Square Developer → Application → Credentials.
# Sandbox uses a different Application ID than production.
VITE_SQUARE_APPLICATION_ID=
VITE_SQUARE_LOCATION_ID=

# Server-only (Supabase Dashboard → Edge Functions → Secrets). Never use VITE_ prefix.
#   SQUARE_ACCESS_TOKEN=your_square_access_token
#   SQUARE_LOCATION_ID=same_as_VITE_SQUARE_LOCATION_ID_or_override
#   SQUARE_ENVIRONMENT=sandbox   # or omit / production for live
#
# Resend — used only in Supabase Edge Functions (new-subscriber, strategy-session-admin-confirm, etc.).
# Set in Supabase Dashboard → Project Settings → Edge Functions → Secrets: RESEND_API_KEY=re_...
# Never use a VITE_ prefix; do not commit real keys to git.
