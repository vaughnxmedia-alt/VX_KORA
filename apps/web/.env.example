# Brand Strategy Session — PR vs marketing video (large mp4; not committed).
# Use the same AWS S3 bucket as the content calendar. Upload under key prefix `site/videos/` (see `S3_VIDEO_FOLDERS.site` in src/lib/s3Upload.ts), then set the public object URL below.
# VITE_PR_VS_MARKETING_VIDEO_URL=https://YOUR_BUCKET.s3.REGION.amazonaws.com/site/videos/pr-vs-marketing.mp4

# Supabase (Project Settings → API). Anon key is safe for the browser; still never commit .env.
# Put this file at apps/web/.env OR at the repo root (KORA/.env) — Vite merges both; apps/web wins on duplicate keys.
# Every variable exposed to the browser MUST start with VITE_. Restart `npm run dev` after editing.
# Public URL of the marketing site (for “Copy link” from Blog Management). Defaults to https://jahknowspr.com.
# VITE_PUBLIC_SITE_URL=https://jahknowspr.com

# Super-ops (dashboard Clients): comma-separated emails allowed for the hover “ops” panel + server RPC.
# If unset, access falls back to profile full_name matching Justice/Jocelyn (weaker; prefer env in production).
# Add the same emails to `super_ops_allowlist` in Supabase (optional extra) or rely on full_name check in RPC.
# VITE_SUPER_OPS_EMAILS=justicevaughn7@gmail.com,ops@example.com

# App owner only (default: justicevaughn7@gmail.com): Auth email + password tools in Clients ops panel + Settings password.
# Must match Edge Function secret APP_OWNER_EMAILS in Supabase (comma-separated).
# VITE_APP_OWNER_EMAILS=justicevaughn7@gmail.com

# Mission Control admin app: shown in dashboard sidebar only for app owner emails (VITE_APP_OWNER_EMAILS).
# Local: http://localhost:5173  |  Production: your deployed mission-control URL (must include protocol).
# VITE_MISSION_CONTROL_URL=http://localhost:5173

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use either the publishable key name or the anon key name (same value from Supabase → API):
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_public_key_here
# VITE_SUPABASE_ANON_KEY=your_anon_public_key_here

# Square Web Payments SDK (public — safe in the browser; never commit real .env to git)
# Application ID and Location ID from Square Developer → Application → Credentials.
# Sandbox uses a different Application ID than production.
VITE_SQUARE_APPLICATION_ID=
VITE_SQUARE_LOCATION_ID=

# Server-only (Supabase Dashboard → Edge Functions → Secrets). Never use VITE_ prefix.
#
# Google Analytics 4 — Dashboard “Website (GA4)” tab (Edge Function `ga4-analytics-report`):
#   1) GCP: enable “Google Analytics Data API” for the project that owns the service account.
#   2) GA4 → Admin → Property access: add the service account email with Viewer on the property.
#   3) Supabase secrets (never commit the JSON file):
#        supabase secrets set GA4_PROPERTY_ID=123456789 --project-ref YOUR_REF
#        supabase secrets set GA4_SERVICE_ACCOUNT_JSON="$(cat ./path/to/service-account.json)" --project-ref YOUR_REF
#      Or paste JSON in Dashboard → Edge Functions → ga4-analytics-report → Secrets.
#   GA4_PROPERTY_ID / GA4_SERVICE_ACCOUNT_JSON are not Vite env vars — do not put them in apps/web/.env.
#
#   APP_OWNER_EMAILS=justicevaughn7@gmail.com   # app-owner-user-credentials (match VITE_APP_OWNER_EMAILS)
#   SQUARE_ACCESS_TOKEN=your_square_access_token
#   SQUARE_LOCATION_ID=same_as_VITE_SQUARE_LOCATION_ID_or_override
#   SQUARE_ENVIRONMENT=sandbox   # or omit / production for live
#
# Resend — used only in Supabase Edge Functions (new-subscriber, strategy-session-admin-confirm, etc.).
# Set in Supabase Dashboard → Project Settings → Edge Functions → Secrets: RESEND_API_KEY=re_...
# Never use a VITE_ prefix; do not commit real keys to git.
#
# OpenAI — pr-assistant-chat (K.O.R.A). Set in Dashboard → Edge Functions → pr-assistant-chat → Secrets (not in Vite .env):
#   OPENAI_API_KEY=sk-...                    # required
#   OPENAI_CHAT_MODEL=gpt-4o               # optional; PR Assistant stream (Chat Completions)
#   OPENAI_RESPONSES_MODEL=gpt-5.4         # optional; Creative Hub (Responses API); use a model your org can call (e.g. gpt-5.4-mini)
