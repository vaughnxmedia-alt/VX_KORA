{
  "name": "@kora/sdk",
  "version": "1.0.0",
  "description": "Shared types, contracts, and utilities for the KORA intelligence system",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "import": "./dist/events/index.mjs",
      "require": "./dist/events/index.js"
    },
    "./lls": {
      "types": "./dist/lls/index.d.ts",
      "import": "./dist/lls/index.mjs",
      "require": "./dist/lls/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.mjs",
      "require": "./dist/http/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.mjs",
      "require": "./dist/auth/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vaughnxmedia-alt/kora-sdk.git"
  },
  "scripts": {
    "build": "tsup src/index.ts src/types/index.ts src/events/index.ts src/lls/index.ts src/http/index.ts src/auth/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts src/types/index.ts src/events/index.ts src/lls/index.ts src/http/index.ts src/auth/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "kora",
    "sdk",
    "types",
    "intelligence",
    "agents"
  ],
  "author": "VaughnX Technology LLC",
  "license": "PROPRIETARY"
}
