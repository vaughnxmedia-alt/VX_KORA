{
  "name": "vx-kora",
  "version": "1.0.0",
  "private": true,
  "description": "K.O.R.A - Knowledge Oriented Retrieval Agents by VaughnX Technology LLC",
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "deploy:edge-strategy": "npm run deploy:edge-strategy --workspace=apps/web",
    "dev:admin": "npm run dev --workspace=apps/mission-control",
    "build:web": "npm run build --workspace=apps/web",
    "build:admin": "npm run build --workspace=apps/mission-control",
    "send-insights": "npm run send-insights --workspace=@kora/telegram-bot",
    "insights:trigger-server": "npm run insights:trigger-server --workspace=@kora/telegram-bot",
    "send-test-report": "npm run send-test-report --workspace=@kora/telegram-bot",
    "supabase": "cd apps/web && npx supabase"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "keywords": ["kora", "ai", "rag", "agents", "marketing"],
