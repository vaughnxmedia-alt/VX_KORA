# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
# Optional: cheaper fallback when Gemini fails (default gpt-4o-mini)
# OPENAI_SYNTHESIS_MODEL=gpt-4o

# Google Gemini (cheaper synthesis for send-insights) — key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Tier 1 / Gemini 2.x: prefer GEMINI_MODEL=gemini-2.5-flash (see AI Studio → model sample for exact id)
# GEMINI_MODEL=gemini-2.5-flash

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# Bot Settings
BOT_USERNAME=@KORAStrategyBot

# Insights trigger (for /run command and Mission Control Trigger Run)
# INSIGHTS_TRIGGER_URL=http://127.0.0.1:3847/run
# TRIGGER_RUN_SECRET=optional_secret_for_POST_run
